# Required for diarization: a Hugging Face access token that has accepted
# the gated model terms at https://hf.co/pyannote/speaker-diarization-3.1
# (log in with the same account the token belongs to and click "Agree").
# Requests with diarize=true/diarize_mic=true will fail loudly without this.
HF_TOKEN=hf_your_token_here

# Optional. Defaults to large-v3 if unset. Must match a size string
# whisper.load_model() accepts (tiny/base/small/medium/large-v3/...).
# Changing this at runtime only matters if the image wasn't pre-baked with
# a different WHISPER_MODEL build arg - see the Dockerfile.
WHISPER_MODEL=large-v3
